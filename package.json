{
  "name": "zenithjoy-workspace",
  "version": "1.10.0",
  "description": "ZenithJoy Monorepo - Social media automation platform (workspace + geoai + creator + jnsy-label)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "build:geoai": "npm run build --workspace=apps/geoai",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:geoai": "npm run dev --workspace=apps/geoai",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "product-map:validate": "node scripts/product-map/cli.mjs validate",
    "product-map:generate": "node scripts/product-map/cli.mjs generate",
    "product-map:check": "node scripts/product-map/cli.mjs check",
    "product-map:gp-smoke-ratchet": "node scripts/product-map/gp-smoke-ratchet.mjs",
    "test:product-map": "node --test scripts/product-map/__tests__/product-map.test.js scripts/product-map/__tests__/gp-smoke-ratchet.test.js scripts/product-map/__tests__/realmachine-unverified-ratchet.test.js"
  },
  "keywords": [
    "monorepo",
    "zenithjoy",
    "social-media",
    "automation"
  ],
  "author": "ZenithJoy Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "vite": "^7.3.2",
    "defu": "^6.1.6",
    "esbuild": "^0.28.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.4"
  }
}
