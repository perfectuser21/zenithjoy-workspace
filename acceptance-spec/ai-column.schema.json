{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenithjoy.internal/acceptance-spec/ai-column.schema.json",
  "title": "AI列结果协议（发版验收双表 · 机器列）",
  "type": "object",
  "required": ["schema_version", "environment", "boundary", "version_stamp", "cells"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "const": "预发后台" },
    "boundary": { "type": "string", "minLength": 1 },
    "version_stamp": {
      "type": "object",
      "required": ["captured_at", "staging_url", "backend_sha", "apk_expected"],
      "additionalProperties": false,
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "staging_url": { "type": "string", "minLength": 1 },
        "backend_sha": { "type": "string", "minLength": 1 },
        "apk_expected": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": { "enum": ["manual", "release"] },
        "operator": { "type": "string" }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict", "criteria", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S\\d+-c[1-4]$" },
          "verdict": { "enum": ["通过", "不通过", "无法验证"] },
          "criteria": { "type": "string", "minLength": 1 },
          "symptoms": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "scenario_required": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
