    "$ADB" -s "$SERIAL" shell input tap "$mm_x" "$mm_y"
    wait_ms 1000
    foreground_gate "${local_eid}-chatinfo"
    if ! _rca="$(resolve_coord "$contact" "「聊天信息」页顶部唯一的那个头像（一对一聊天这里只显示对方一个头像）" chatinfo-avatar "${local_eid}-chatinfoavatar")"; then
      die "could not find contact avatar on 聊天信息 page (tree and vision both failed)" TARGET_ABSENT
    fi
    read av_x av_y <<< "$(print -- "$_rca" | /usr/bin/head -1)"
    "$ADB" -s "$SERIAL" shell input tap "$av_x" "$av_y"
    wait_ms 1200
    foreground_gate "${local_eid}-profile"
    # 核验落地页确实是目标联系人的资料页而不是别的什么页，防止上面的定位链路悄悄
    # 走偏又没有明确报错（比如又落回自己资料页）——用视觉是非判断兜底一次，便宜且关键。
    verify_out="$(vision_judge "这个页面顶部显示的姓名/昵称是不是『${contact}』（或者明显是同一个人，允许有备注名差异）？" "${local_eid}-profileverify")" || die "profile identity verify call failed" TARGET_ABSENT
    [[ "$verify_out" == "YES" ]] || die "SAFETY_ABORT: landed profile does not appear to belong to ${contact} (verify=$verify_out) — refusing to proceed to avoid acting on the wrong person's moments" TARGET_ABSENT
    if ! _rcf="$(resolve_coord "朋友圈" "个人资料页里的「朋友圈」这一行（旁边通常有几张缩略图预览）" "moments-row-${contact}" "${local_eid}-profile" nocache)"; then
      die "contact profile has no 朋友圈 row / could not locate it (may have hidden moments from us, or tree and vision both failed)" TARGET_ABSENT
    fi
    read fr_x fr_y <<< "$(print -- "$_rcf" | /usr/bin/head -1)"
    "$ADB" -s "$SERIAL" shell input tap "$fr_x" "$fr_y"
    wait_ms 1200
    print -- "evidence=$(snapshot_evidence "${local_eid}-contact-moments")"
    ;;

  read-moments-list)
    # 读取当前屏幕上"某联系人朋友圈摘要列表"页面的内容，输出JSON数组供上层做判断
    # （能不能点赞/能不能跟发）——本命令只读不判断，判断逻辑不属于这个脚本。
    # 前置：已执行过 open-contact-moments。
    [[ "$#" == 2 ]] || die "usage: wechat-moments-adb --profile PROFILE read-moments-list EVIDENCE_ID"
    check_target
    local_eid="$2"
    shot="$EVIDENCE_ROOT/${local_eid}-list.png"
    /bin/mkdir -p "$EVIDENCE_ROOT"
    "$ADB" -s "$SERIAL" exec-out screencap -p > "$shot" || die "read-moments-list screenshot failed"
    [[ -r "$LOCATE_KEY_FILE" ]] || die "locate api key file missing: $LOCATE_KEY_FILE"
    out="$("$PYTHON_BIN" - "$shot" "$LOCATE_ENDPOINT" "$LOCATE_MODEL" "$LOCATE_KEY_FILE" <<'PYLIST'
import base64, json, sys, urllib.request
shot, endpoint, model, keyfile = sys.argv[1:5]
key = open(keyfile).read().strip()
img = base64.b64encode(open(shot, "rb").read()).decode()
prompt = ("这是微信朋友圈动态摘要列表（每条含日期+文字摘要+可能的缩略图）。把当前截图里可见的"
          "每一条动态都列出来，输出JSON数组，每个元素是{\"date\":\"日期文字，如原样抄\",\"text\":\"该条文字摘要\","
          "\"has_image\":true或false}。只输出JSON数组本身，不要markdown代码块，不要额外说明。")
body = {"model": model, "max_tokens": 800, "messages": [{"role": "user", "content": [
  {"type": "image_url", "image_url": {"url": "data:image/png;base64," + img}},
  {"type": "text", "text": prompt}]}]}
req = urllib.request.Request(endpoint, data=json.dumps(body).encode(),
  headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
r = json.load(urllib.request.urlopen(req, timeout=45))
txt = r["choices"][0]["message"]["content"].strip().strip("`")
if txt.startswith("json"): txt = txt[4:]
json.loads(txt)  # 校验确实是合法JSON，非法直接抛错让shell层die
print(txt)
PYLIST
)" || die "read-moments-list model call failed or returned invalid JSON"
    print -- "$out"
    print -- "evidence=$shot"
    ;;

  open-moment-card-by-text)
    # 在当前朋友圈摘要列表里，找到文字匹配给定片段的那一条，点开进入可互动卡片视图
    # （带赞/评论/详情按钮的那个页面）。match_text 应该来自 read-moments-list 的输出，
    # 不要凭空传一个猜的片段。
    [[ "$#" == 3 ]] || die "usage: wechat-moments-adb --profile PROFILE open-moment-card-by-text MATCH_TEXT_B64 EVIDENCE_ID"
    check_target
    match_text="$(print -- "$2" | /usr/bin/base64 -d)"
    local_eid="$3"
    if ! _rcm="$(resolve_coord "$match_text" "朋友圈摘要列表里文字内容包含『${match_text:0:20}』的那一条" "moment-card-${local_eid}" "${local_eid}-findcard" nocache)"; then
      die "could not locate the moment matching given text (tree and vision both failed)" TARGET_ABSENT
    fi
