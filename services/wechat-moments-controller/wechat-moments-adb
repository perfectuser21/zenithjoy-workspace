  like-current-card)
    # 前置：已经点开某条具体动态进入卡片/详情视图（上层用截图判断了内容安全、点了那一条）。
    # 本命令只负责：找到「赞」按钮 → 点 → 核验点赞列表里出现自己头像。
    # 0917 实证：同为单条动态详情页，存在两种布局——
    #   A) 直接可见「赞 评论 详情」三按钮条；
    #   B)「详情」页默认只显示评论输入框，赞/评论按钮被折叠进日期旁边的「···」小图标，
    #      需先点它弹出悬浮条（♡赞｜评论）才能继续点赞。
    #   ⚠️ 不能靠 resolve_coord 对「赞」的成功/失败来判断走哪条路——0917 实测发现视觉模型
    #      在目标尚不存在时仍可能"蒙"出一个坐标（碰巧点中「···」触发弹出，或点到无关处），
    #      让失败判断失真。必须先用 vision_judge 显式问一句"现在看不看得见"，用明确的
    #      YES/NO 决定要不要先展开，而不是拿 locate 的 return code 当信号。
    [[ "$#" == 2 ]] || die "usage: wechat-moments-adb --profile PROFILE like-current-card EVIDENCE_ID"
    check_target
    local_eid="$2"
    bar_visible="$(vision_judge "这张截图下半部分是否已经直接显示一个包含心形「赞」和「评论」字样的操作条/按钮（不需要点任何东西就已经看得见）？" "${local_eid}-barcheck")" || die "bar visibility check call failed" TARGET_ABSENT
    if [[ "$bar_visible" != "YES" ]]; then
      print -u2 -- "info: 赞/评论 not directly visible — 详情页布局B，先展开「···」(0917 实证)"
      if ! _rcmore="$(resolve_coord "更多" "这条动态发布日期文字右边紧贴着的一个很小的「···」或两个圆点的更多选项图标" detail-more-btn "${local_eid}-detailmore" nocache)"; then
        die "could not locate the「···」expand icon (tree and vision both failed)" TARGET_ABSENT
      fi
      read dm_x dm_y <<< "$(print -- "$_rcmore" | /usr/bin/head -1)"
      "$ADB" -s "$SERIAL" shell input tap "$dm_x" "$dm_y"
      wait_ms 900
    fi
    if ! _rc7="$(resolve_coord "赞" "「赞」这个按钮/选项（心形图标+文字赞，可能在卡片底部固定按钮条里，也可能在刚弹出的悬浮条里，和「评论」并列）" like-btn "${local_eid}-likebtn" nocache)"; then
      die "could not locate 赞 button (tree and vision both failed)" TARGET_ABSENT
    fi
    read lk_x lk_y <<< "$(print -- "$_rc7" | /usr/bin/head -1)"
    "$ADB" -s "$SERIAL" shell input tap "$lk_x" "$lk_y"
    wait_ms 1200
    verify_out="$(vision_judge "这张截图里，这条朋友圈下方是否出现了一个点赞列表（显示点赞者头像，前面通常有个心形图标）？" "${local_eid}-likeverify")" || die "like verify call failed" TARGET_ABSENT
    [[ "$verify_out" == "YES" ]] || die "SAFETY_ABORT: tapped 赞 but no like-list/avatar appeared afterward — cannot confirm the like actually registered" TARGET_ABSENT
    print -- "like_tapped=1"
    print -- "like_verified=1"
    print -- "evidence=$(snapshot_evidence "${local_eid}-after-like")"
    ;;

  lock-acquire)
    [[ "$#" == 2 ]] || die "usage: wechat-moments-adb --profile PROFILE lock-acquire RUN_ID"
    require_run_id "$2"
    lock_owner_id="$(normalize_run_id "$2")"
    /bin/mkdir -p "$LOCK_ROOT"
    _lk_ok=0
    for _lk_try in 1 2 3; do
      if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
        /usr/bin/printf '%s\n' "$lock_owner_id" > "$LOCK_DIR/owner"
        /bin/date +%s > "$LOCK_DIR/acquired_at"
        print -- "lock=acquired owner=$lock_owner_id"
        _lk_ok=1; break
      elif [[ -r "$LOCK_DIR/owner" ]] && same_run_lock "$(<"$LOCK_DIR/owner")" "$lock_owner_id"; then
        print -- "lock=held owner=$(<"$LOCK_DIR/owner") idempotent=true"
        _lk_ok=1; break
      elif lock_is_stale; then
        owner="unknown"; [[ -r "$LOCK_DIR/owner" ]] && owner="$(<"$LOCK_DIR/owner")"
        print -u2 -- "warning: reclaiming stale lock (prev owner=$owner); retrying atomic acquire"
        /bin/rm -rf "$LOCK_DIR" 2>/dev/null
        /bin/sleep 0.2
        continue
      else
        break
      fi
    done
    if (( ! _lk_ok )); then
      owner="unknown"
      [[ -r "$LOCK_DIR/owner" ]] && owner="$(<"$LOCK_DIR/owner")"
      _age=""; [[ -r "$LOCK_DIR/acquired_at" ]] && _age="age=$(( $(/bin/date +%s) - $(<"$LOCK_DIR/acquired_at") ))s/ttl=${LOCK_TTL_SECONDS}s"
      die "lock is held by another run: $owner $_age"
    fi
    ;;

  lock-status)
    [[ "$#" == 1 ]] || die "usage: wechat-moments-adb --profile PROFILE lock-status"
    if [[ -r "$LOCK_DIR/owner" ]]; then
      _age="?"; [[ -r "$LOCK_DIR/acquired_at" ]] && _age="$(( $(/bin/date +%s) - $(<"$LOCK_DIR/acquired_at") ))"
      if lock_is_stale; then
        print -- "lock=held owner=$(<"$LOCK_DIR/owner") age=${_age}s stale=true ttl=${LOCK_TTL_SECONDS}s"
      else
        print -- "lock=held owner=$(<"$LOCK_DIR/owner") age=${_age}s stale=false ttl=${LOCK_TTL_SECONDS}s"
      fi
    else
      print -- "lock=free"
    fi
    ;;

  lock-release)
    [[ "$#" == 2 ]] || die "usage: wechat-moments-adb --profile PROFILE lock-release RUN_ID"
    require_run_id "$2"
    lock_owner_id="$(normalize_run_id "$2")"
    [[ -r "$LOCK_DIR/owner" ]] || { print -- "lock=free"; exit 0; }
    owner="$(<"$LOCK_DIR/owner")"
    same_run_lock "$owner" "$lock_owner_id" || die "refusing to release lock owned by another run: $owner"
    /bin/rm -rf "$LOCK_DIR"
    print -- "lock=released owner=$lock_owner_id"
    ;;

  *)
    die "allowed commands: status open-wechat open-moments compose-photo-post publish verify-latest-post open-contact-moments like-current-card lock-acquire lock-status lock-release"
    ;;
esac
