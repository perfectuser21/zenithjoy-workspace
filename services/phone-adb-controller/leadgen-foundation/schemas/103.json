{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_key",
    "business"
  ],
  "properties": {
    "binding_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_mode",
            "comment_ids",
            "sources"
          ],
          "properties": {
            "input_mode": {
              "const": "committed_partial_ids"
            },
            "comment_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
              }
            },
            "sources": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
