{
  "version": 1,
  "capability": "douyin_video_discovery",
  "brain_workflow_key": "douyin_video_discovery",
  "contract_sha256": "a38a93e16d6c4caa87fdb76e741f883b42aa34f83f759d4e3d1f63968203f6dd",
  "promotion": {
    "min_consecutive_pass": 20
  },
  "steps": [
    {
      "key": "douyin_video_processing.preflight.acquire_device_lock",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_acquired",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.refresh_lock_heartbeat",
      "activity": "preflight",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "锁心跳续期3次仍未确认成功",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.verify_device_identity",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.device_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.verify_call_idle",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.call_state_idle",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.read_account_mark",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-account-profile.xml",
        "match": "抖音号：",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.open_run_ledger",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "stage": "preflight",
        "field": "status",
        "equals": "completed",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.open_search",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "hard",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-source-*-readback.json",
        "match": "\"verified\"\\s*:\\s*true",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.switch_video_tab",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-src*-vtab-aftertab.xml",
        "match": "视频[^>]*selected=\"true\"",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.open_filter_panel",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-src*-filter-panel1.*",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.choose_filters",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-src*-filter-selected.*",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.apply_filters",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-src*-filter-results.*",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.extract_video_cards",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-src*-cards-grid.xml",
        "expect": {
          "op": ">=",
          "ref": "metrics.sources_succeeded"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.resolve_video_links",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "视频链接解析失败",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.persist_candidates",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.manifest_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.push_videos",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "sql",
        "query": "SELECT count(*) FROM zenithjoy.leadgen_videos WHERE harvest_batch = '$RUN_TAG'",
        "expect": {
          "op": ">=",
          "ref": "metrics.videos_pushed"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_discovery.collect_videos.readback_line_key",
      "activity": "collect_videos",
      "at": "collect_videos",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.manifest_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "collect_videos",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_processing.cleanup.close_app",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.close_app_attempts",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.release_lock",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_released",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.return_safe_desktop",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.safe_desktop_visible",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.finalize_run",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "field": "items_total",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_discovery",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    }
  ]
}
