{
  "version": 1,
  "capability": "douyin_lead_outreach",
  "brain_workflow_key": "douyin_lead_outreach",
  "contract_sha256": "ef8ad51b91004ee7f114f8ad43dcc5937391c2e00e29a681eb4e90cc26bb376f",
  "promotion": {
    "min_consecutive_pass": 20
  },
  "steps": [
    {
      "key": "douyin_lead_outreach.preflight.acquire_device_lock",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_acquired",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.refresh_lock_heartbeat",
      "activity": "preflight",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "锁心跳续期3次仍未确认成功",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.verify_device_identity",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.device_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.verify_call_idle",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.call_state_idle",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.read_account_mark",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-account-profile.xml",
        "match": "抖音号：",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.open_run_ledger",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "stage": "preflight",
        "field": "status",
        "equals": "completed",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.check_breaker_and_cap",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "已熔断\\(见|已因风控停发\\(见|已达阶梯上限",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.preflight.verify_sender_account",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "失败\\(account_mismatch\\)",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_lead_outreach.send_dm.pick_order",
      "activity": "send_dm",
      "at": "send_dm",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "单#[0-9]+:",
        "expect": {
          "op": ">=",
          "ref": "metrics.orders_picked"
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "send_dm",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_lead_outreach.send_dm.send_private_message",
      "activity": "send_dm",
      "at": "send_dm",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "✅ 单#[0-9]+ 送达|仅互关限制",
        "expect": {
          "op": ">=",
          "ref": "metrics.messages_sent"
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "send_dm",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_lead_outreach.send_dm.verify_delivery",
      "activity": "send_dm",
      "at": "send_dm",
      "mode": "checkpoint",
      "readback": {
        "type": "none"
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "send_dm",
        "sequence_no": 2
      },
      "reason": "送达核验在 private-message-send 现场读气泡与提示文案，结果只体现在 ✅/⚠️/🚦 分支；聊天界面没有持久化产物，事后读不回对方是否可收"
    },
    {
      "key": "douyin_lead_outreach.write_back.write_back_result",
      "activity": "write_back",
      "at": "write_back",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-write_back-readback.json",
        "match": "\"verified\"\\s*:\\s*true",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "write_back",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_lead_outreach.cleanup.close_app",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.close_app_attempts",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "cleanup",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_lead_outreach.cleanup.release_lock",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_released",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "cleanup",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_lead_outreach.cleanup.return_safe_desktop",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.safe_desktop_visible",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "cleanup",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_lead_outreach.cleanup.finalize_run",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "field": "items_total",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_lead_outreach",
        "slot_key": "cleanup",
        "sequence_no": 4
      }
    }
  ]
}
