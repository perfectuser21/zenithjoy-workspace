{
  "version": 1,
  "capability": "douyin_video_processing",
  "brain_workflow_key": "douyin_video_processing",
  "contract_sha256": "fdc134e3e0f93a74fb53d3755a81d340012f54c34efe05fbb4de2f68f92be786",
  "promotion": {
    "min_consecutive_pass": 20
  },
  "steps": [
    {
      "key": "douyin_video_processing.preflight.acquire_device_lock",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_acquired",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.refresh_lock_heartbeat",
      "activity": "preflight",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "锁心跳续期3次仍未确认成功",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.verify_device_identity",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.device_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.verify_call_idle",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.call_state_idle",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.read_account_mark",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-account-profile.xml",
        "match": "抖音号：",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.preflight.open_run_ledger",
      "activity": "preflight",
      "at": "preflight",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "stage": "preflight",
        "field": "status",
        "equals": "completed",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "preflight",
        "sequence_no": 1
      }
    },
    {
      "key": "douyin_video_processing.dedup.filter_history",
      "activity": "dedup",
      "at": "dedup",
      "mode": "hard",
      "readback": {
        "type": "metric",
        "ref": "metrics.historical_filter_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "dedup",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_processing.dedup.filter_own_accounts",
      "activity": "dedup",
      "at": "dedup",
      "mode": "hard",
      "readback": {
        "type": "metric",
        "ref": "metrics.own_filter_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "dedup",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_processing.dedup.filter_current_run",
      "activity": "dedup",
      "at": "dedup",
      "mode": "hard",
      "readback": {
        "type": "metric",
        "ref": "metrics.run_dedup_verified",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "dedup",
        "sequence_no": 2
      }
    },
    {
      "key": "douyin_video_processing.qualification.cheap_gate",
      "activity": "qualification",
      "at": "qualification",
      "mode": "hard",
      "readback": {
        "type": "evidence",
        "glob": "{tag}-identity-*.json",
        "match": "\"verified\"\\s*:\\s*true[\\s\\S]*\"content_type\"\\s*:\\s*\"video\"",
        "expect": {
          "op": ">=",
          "ref": "metrics.videos_verified"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.qualification.unmute_before_record",
      "activity": "qualification",
      "at": "qualification",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "audio_rejected reason=silent_or_unknown_volume",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.qualification.record_triple_speed",
      "activity": "qualification",
      "at": "qualification",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "audio_rejected reason=short_or_unknown_duration",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.qualification.extract_audio",
      "activity": "qualification",
      "at": "qualification",
      "mode": "checkpoint",
      "readback": {
        "type": "log",
        "regex": "audio_upload_failed",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.qualification.transcribe",
      "activity": "qualification",
      "at": "qualification",
      "mode": "checkpoint",
      "readback": {
        "type": "sql",
        "query": "SELECT count(*) FROM zenithjoy.leadgen_videos WHERE harvest_batch = '$RUN_TAG' AND judgment_status <> 'pending' AND coalesce(transcript, '') = '' AND coalesce(judgment_reason, '') NOT LIKE '转写为空%' AND coalesce(judgment_reason, '') NOT LIKE 'V2便宜闸%'",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.qualification.judge_content",
      "activity": "qualification",
      "at": "qualification",
      "mode": "checkpoint",
      "readback": {
        "type": "sql",
        "query": "SELECT count(*) FROM zenithjoy.leadgen_videos WHERE harvest_batch = '$RUN_TAG' AND judgment_status <> 'pending' AND coalesce(judgment_reason, '') = ''",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "qualification",
        "sequence_no": 3
      }
    },
    {
      "key": "douyin_video_processing.collection.open_comment_section",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}*-comments-panel.xml",
        "match": "[0-9万.]+条评论",
        "expect": {
          "op": ">=",
          "ref": "metrics.videos_processed"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.collect_comments",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}*-screen*-comments.xml",
        "expect": {
          "op": ">=",
          "ref": "metrics.videos_processed"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.verify_commenter_identity",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "evidence",
        "glob": "{tag}*-person*-profile.xml",
        "match": "抖音号：",
        "expect": {
          "op": ">=",
          "ref": "metrics.comments_collected"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.resolve_profile_link",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "tsv",
        "regex": "^LEAD\\t([^\\t]*\\t){7}{word}\\t[^\\t]*\\t\\t",
        "expect": {
          "op": "<=",
          "value": 0
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.mark_video_collected",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "sql",
        "query": "SELECT count(*) FROM zenithjoy.leadgen_videos WHERE harvest_batch = '$RUN_TAG' AND process_status = '评论已采'",
        "expect": {
          "op": ">=",
          "ref": "metrics.videos_processed"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.return_to_results",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.rescan_rate",
        "expect": {
          "op": "<=",
          "value": 0.3
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.collection.push_raw_comments",
      "activity": "collection",
      "at": "collection",
      "mode": "checkpoint",
      "readback": {
        "type": "sql",
        "query": "SELECT count(*) FROM zenithjoy.leadgen_comments WHERE harvest_batch = '$RUN_TAG'",
        "expect": {
          "op": ">=",
          "ref": "metrics.comments_collected"
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "collection",
        "sequence_no": 4
      }
    },
    {
      "key": "douyin_video_processing.cleanup.close_app",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.close_app_attempts",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.release_lock",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.lock_released",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.return_safe_desktop",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "metric",
        "ref": "metrics.safe_desktop_visible",
        "expect": {
          "op": "==",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    },
    {
      "key": "douyin_video_processing.cleanup.finalize_run",
      "activity": "cleanup",
      "at": "cleanup",
      "mode": "checkpoint",
      "readback": {
        "type": "ledger",
        "field": "items_total",
        "expect": {
          "op": ">=",
          "value": 1
        }
      },
      "usage": {
        "workflow_key": "douyin_video_processing",
        "slot_key": "cleanup",
        "sequence_no": 5
      }
    }
  ]
}
