    "$ADB" -s "$SERIAL" shell input tap "$cl_sx" "$cl_sy"; wait_ms 400
    "$ADB" -s "$SERIAL" shell input keyevent 279; wait_ms 800
    ui_evidence "$2-scratch2" >/dev/null
    cl_txt="$(/usr/bin/grep -oE '<node[^>]+resource-id="com.ss.android.ugc.aweme:id/et_search_kw"[^>]*>' "$EVIDENCE_ROOT/$2-scratch2.xml" | /usr/bin/head -1 | /usr/bin/grep -oE 'text="[^"]*"' | /usr/bin/sed 's/^text="//;s/"$//' | /usr/bin/sed 's/&amp;/\&/g; s/&#47;/\//g')"
    cl_short="$(print -- "$cl_txt" | /usr/bin/grep -oE 'https://v\.douyin\.com/[A-Za-z0-9_/-]+' | /usr/bin/head -1)"
    [[ -n "$cl_short" ]] || die "CARD_LINK: clipboard had no douyin short link (got: ${cl_txt:0:60})" TARGET_ABSENT
    clip_guard_check "$cl_short"
    # 0915 主理人拍板(决策 f88a5b86): 剪贴板原文短链直存直开,不再 curl 抠 sec_uid 转长链——
    # 短链是抖音 App 全路径认领的形态可直接打开;长链 App 不认领,真机实证 intent 不可解析
    # 只能走 AppLinkHandler+网页版中转绕道(存量长链单仍由该绕道兜底)。字段名 profile_url 不变,下游零改动。
    print -- "card_short_url=$cl_short"
    print -- "profile_url=$cl_short"
    clip_guard_record "$cl_short"
    # 现场恢复:暂存搜索页 → back 回主页 → back 回评论区(批量循环依赖此收尾)
    "$ADB" -s "$SERIAL" shell input keyevent 4; wait_ms 1200
    "$ADB" -s "$SERIAL" shell input keyevent 4; wait_ms 1500
    ui_evidence "$2-restored" >/dev/null 2>&1 || true
    /usr/bin/grep -Eq '评论|comment' "$EVIDENCE_ROOT/$2-restored.xml" 2>/dev/null       || print -u2 -- "warning: comment context not confirmed after card-link restore"
    ;;
  commenter-identity)
    [[ "$#" == 5 ]] || die "usage: douyin-phone-adb --profile PROFILE commenter-identity X Y NICKNAME_B64 EVIDENCE_ID"
    check_target
    read_commenter_identity "$2" "$3" "$4" "$5"
