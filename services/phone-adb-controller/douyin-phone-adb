        # 而不是像以前那样在错误文案里说一句"likely still on 综合 tab"就放弃。
        print -u2 -- "warning: hierarchy unreadable on the results page — almost certainly still on 综合 tab; auto-switching to 视频 tab"
        svc_c="$(locate_cached vtab "顶部搜索结果标签栏中的「视频」标签" "$2-autotab")" || die "could not capture search grid hierarchy and the 视频 tab could not be located visually"
        read svc_tx svc_ty <<< "$svc_c"
        "$ADB" -s "$SERIAL" shell input tap "$svc_tx" "$svc_ty"
        wait_ms 1800
        svc_xml="$(ui_evidence "$2-grid-after-autotab")" || die "still could not capture the search grid hierarchy after auto-switching to the 视频 tab"
      fi
      svc_out="$(video_cards_from_xml "$svc_xml")"
      [[ -n "$svc_out" ]] && break
      if /usr/bin/grep -q "搜索结果为空" "$svc_xml"; then
        print -- "cards=0"
        print -- "empty_results=true"
        print -- "evidence=$svc_xml"
        exit 0
      fi
      print -u2 -- "warning: no video cards in hierarchy (business retry $svc_try/3); page did not report 搜索结果为空"
      (( svc_try < 3 )) && wait_seconds 15
    done
    [[ -n "$svc_out" ]] || die "no video cards found after 3 business retries and the page never reported 搜索结果为空; likely still on 综合 tab (auto-playing feed never reaches idle)"
    print -- "$svc_out"
    print -- "evidence=$svc_xml"
