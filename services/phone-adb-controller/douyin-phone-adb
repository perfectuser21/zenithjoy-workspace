    print -- "tapped $lx $ly evidence=$EVIDENCE_ROOT/$3-after.png"
    ;;
  open-video)
    # 0913：collection 阶段要回到 discovery 已验证的那条视频。以前没有这条命令，
    # worker 只能重走搜索（撞上综合 tab 永不 idle 的墙，三次尝试全废）。
    # 正解=用平台 deeplink 确定性直开详情页，再用分享按钮守卫复验落点。
    [[ "$#" == 3 ]] || die "usage: douyin-phone-adb --profile PROFILE open-video VIDEO_ID EVIDENCE_ID"
    check_target
    ov_id="$2"
    [[ "$ov_id" == <-> && ${#ov_id} -ge 16 && ${#ov_id} -le 24 ]] || die "VIDEO_ID must be the 16-24 digit platform video id"
    require_evidence_id "$3"
    "$ADB" -s "$SERIAL" shell am start -a android.intent.action.VIEW -d "snssdk1128://aweme/detail/$ov_id" >/dev/null
    # 融合刀7(先探后睡): 500ms 步进探前台,快机省 ~1.5s,慢机预算放宽到 4s
    ov_fg=0
    for _p in 1 2 3 4 5 6 7 8; do
      wait_ms 500
      [[ "$(foreground_package)" == *"$DOUYIN_PACKAGE"* ]] && { ov_fg=1; break }
    done
    (( ov_fg )) || die "Douyin did not come to foreground after the detail deeplink" WRONG_FOREGROUND
    foreground_gate "$3-gate"
    ov_g=0; _on_video_detail "$3-openvideo" || ov_g=$?
    if (( ov_g == 2 )); then
      wait_ms 3000
      ov_g=0; _on_video_detail "$3-openvideo-w2" || ov_g=$?
    fi
    (( ov_g == 0 )) || die "detail deeplink for $ov_id did not land on a verified video detail page (guard rc=$ov_g)"
    snapshot_evidence "$3-openvideo-ok" >/dev/null
    # 0913 主理人拍板：评论数是详情页树上零成本的字段，必须随开页输出——
    # 零评论的视频不许流向录屏/ASR（最贵工序不该排在最便宜的过滤器前面）。
    # 有数字形态：评论3，按钮 / 评论736，按钮 / 评论1.2万，按钮；
    # 零评论实测形态：评论评论，按钮（无数字）⇒ comment_count=0。
    ov_cc_xml="$EVIDENCE_ROOT/$3-openvideo-w1.xml"
    [[ -s "$EVIDENCE_ROOT/$3-openvideo-w2-w1.xml" ]] && ov_cc_xml="$EVIDENCE_ROOT/$3-openvideo-w2-w1.xml"
    ov_cc="$(/usr/bin/grep -oE 'content-desc="评论[0-9][^，"]*，按钮"' "$ov_cc_xml" 2>/dev/null | /usr/bin/head -1 | /usr/bin/sed -E 's/.*评论([0-9][^，"]*)，按钮.*/\1/' || true)"
    print -- "video_opened=1"
    print -- "video_id=$ov_id"
    print -- "comment_count=${ov_cc:-0}"
    ;;
  open-comments)
    [[ "$#" == 2 ]] || die "usage: douyin-phone-adb --profile PROFILE open-comments EVIDENCE_ID"
    check_target
    open_comments "$2"
    ;;
  search-video-tab)
    # 关8前置：把搜索结果切到「视频」tab。
    # 为什么必须切：综合 tab 是内嵌自动播放的 feed，uiautomator dump 永远
    # `could not get idle state`（2026-09-11 真机连抓 3 次全 0 节点；wrapper 现有的
    # keyevent 85 媒体键对 feed 内嵌播放器无效，那招只在视频详情页管用）。
    # 视频 tab 是静态缩略图网格，同一台机同一秒 dump 出 182 节点。
    #
    # 树优先 → 视觉兜底（主理人拍板的定位顺序）：
    #   先试读树取「视频」tab 的 bounds；综合 tab 读不出树时才退到视觉定位。
    [[ "$#" == 2 ]] || die "usage: douyin-phone-adb --profile PROFILE search-video-tab EVIDENCE_ID"
    check_target
    vt_src=""
    # 这里是「机会性读树」：综合 tab 上明知读不到（feed 永不 idle），
    # 所以只用单波快速失败，立刻退到视觉兜底；不能用带三波重试的 ui_evidence，
    # 否则每次切 tab 都要先白烧约 180 秒（0912 我改三波时引入的回归，已修）。
    if vt_xml="$(_ui_evidence_wave "$2-tabs" 2>/dev/null)"; then
      vt_line="$(/usr/bin/grep -oE '<node[^>]*text="视频"[^>]*bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' "$vt_xml" | /usr/bin/head -1)"
      if [[ -n "$vt_line" ]]; then
        read vt_x1 vt_y1 vt_x2 vt_y2 <<< "$(print -- "$vt_line" | /usr/bin/sed -E 's/.*bounds="\[([0-9]+),([0-9]+)\]\[([0-9]+),([0-9]+)\]".*/\1 \2 \3 \4/')"
        vt_x=$(( (vt_x1 + vt_x2) / 2 )); vt_y=$(( (vt_y1 + vt_y2) / 2 )); vt_src=tree
      fi
    fi
    if [[ -z "$vt_src" ]]; then
      vt_center="$(locate_cached vtab "顶部搜索结果标签栏中的「视频」标签" "$2-vtab")" || die "video tab locate failed (tree unreadable and vision fallback failed)"
      read vt_x vt_y <<< "$vt_center"; vt_src=vision
    fi
    "$ADB" -s "$SERIAL" shell input tap "$vt_x" "$vt_y"
    wait_ms 1500
    # 打开后验证：切成功的标志是树能读出来且「视频」处于 selected
    vt_after="$(ui_evidence "$2-aftertab")" || die "video tab tap did not settle into a readable page"
    /usr/bin/grep -qE '<node[^>]*text="视频"[^>]*selected="true"' "$vt_after" \
      || die "video tab is not selected after tap"
    print -- "video_tab=1"
    print -- "coord_source=$vt_src"
    print -- "tapped=$vt_x $vt_y"
    print -- "evidence=$vt_after"
    ;;
  collect-comments)
    # 关11：把当前已打开的评论面板里的评论读出来（须先 open-comments 成功）。
    # 输出 TSV：昵称 正文 日期 地区 作者标记 tap=<头像中心x y> b64=<昵称base64>；
    # 末行 exhausted=0|1。验证身份时把 tap 坐标与 b64 逐字复制给 commenter-identity，绝不自算。
    [[ "$#" == 2 ]] || die "usage: douyin-phone-adb --profile PROFILE collect-comments EVIDENCE_ID"
