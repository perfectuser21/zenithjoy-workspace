if len(points) < 500:
    raise SystemExit("filter action locator failed: red result-button signature missing")

by_row = {}
for x, y in points:
    by_row.setdefault(y, []).append(x)
rows = sorted(by_row)
bands, current = [], [rows[0]]
for prev, cur in zip(rows, rows[1:]):
    if cur - prev <= 9:
        current.append(cur)
    else:
        bands.append(current)
        current = [cur]
bands.append(current)
best = max(bands, key=lambda band: sum(len(by_row[y]) for y in band))
cluster = [(x, y) for y in best for x in by_row[y]]
if len(cluster) < 500:
    raise SystemExit("filter action locator failed: red result-button signature missing")
print(f"{int(statistics.median(x for x, _ in cluster))} {int(statistics.median(y for _, y in cluster))}")
PY
