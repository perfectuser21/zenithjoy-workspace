#!/bin/zsh

set -euo pipefail
setopt EXTENDED_GLOB

ADB="${DOUYIN_ADB_BIN:-/opt/homebrew/bin/adb}"
# 需自带 Pillow。用无版本号软链（现指向 3.14.5），Python 升级不再断链。
# 不要改成裸 python3：本机另有不含 Pillow 的 python3.12，且节点按绝对路径审批命令。
PYTHON_BIN="${DOUYIN_PYTHON_BIN:-/opt/homebrew/bin/python3}"
# 受控录制链（qualification / 参考转写的唯一录制入口）。绝对路径 = 节点按可执行文件审批的安全设计。
SCRCPY="${DOUYIN_SCRCPY_BIN:-/opt/homebrew/bin/scrcpy}"
FFMPEG="${DOUYIN_FFMPEG_BIN:-/opt/homebrew/bin/ffmpeg}"
FFPROBE="${DOUYIN_FFPROBE_BIN:-/opt/homebrew/bin/ffprobe}"
# 视觉定位（vision grounding）：截图→模型报归一化坐标→点击。根治无障碍树的机型/版本适配病。
LOCATE_KEY_FILE="${DOUYIN_LOCATE_KEY_FILE:-$HOME/.config/openclaw/locate-api.key}"
LOCATE_ENDPOINT="${DOUYIN_LOCATE_ENDPOINT:-https://toapis.com/v1/chat/completions}"
LOCATE_MODEL="${DOUYIN_LOCATE_MODEL:-gemini-2.5-flash-lite-official}"
REGISTRY="${DOUYIN_PHONE_REGISTRY:-${HOME}/.config/openclaw/douyin-phone-profiles.tsv}"
ACCOUNT_REGISTRY="${DOUYIN_ACCOUNT_REGISTRY:-${HOME}/.config/openclaw/douyin-account-routes.tsv}"

die() {
  # 0914 融合(抄 Kotlin WaitFailure 三态归因): 可选第二参 NO_ROOT/WRONG_FOREGROUND/TARGET_ABSENT,
  # 让上游脚本/Commander 不用猜死因就能选对策(重试/救前台/换目标)。
  print -u2 -- "$1"
  [[ -n "${2:-}" ]] && print -u2 -- "failure_class=$2"
  exit 2
}

require_uint() {
  [[ "$1" == <-> ]] || die "expected non-negative integer"
}

[[ "${1:-}" == "--profile" && "$#" -ge 3 ]] || die "usage: douyin-phone-adb --profile PROFILE COMMAND [ARGS...]"
PROFILE="$2"
shift 2

[[ -r "$REGISTRY" ]] || die "phone profile registry is not readable"
# registry 按列名解析，v1(5列无表头) 与 v2(带表头,列可增) 双兼容。
# 不按位置读：shell 的 read 会把多余列全挤进最后一个变量，registry 一加列
# require_uint "$MAX_Y" 就会失败而 die，导致所有设备停摆。
# 输出固定 11 列、用 US(0x1F) 分隔——TAB 是空白类 IFS，连续两个会被折叠，
# v1 缺 density 那一空列会让后面所有列左移。
_registry_row="$(/usr/bin/awk -F'\t' -v profile="$PROFILE" '
BEGIN{sc=1;hh=0;fd=0}
/^#[ \t]*schema=/{if($0~/v2/)sc=2;next}
/^#registry_version/{n=split($0,a,/[ \t]+/);if(n>=2)sc=a[2]+0;next}
!hh&&($1=="profile"||$1=="#profile"){for(i=1;i<=NF;i++){nm=$i;sub(/^#/,"",nm);c[nm]=i}hh=1;if(sc<2)sc=2;next}
/^#/{next}
/^[ \t]*$/{next}
$1==profile&&!fd{fd=1
 if(hh){p=g("profile");s=g("serial");m=g("model");w=g("width");h=g("height");
        if(w=="")w=g("screen_w");if(h=="")h=g("screen_h");
        d=g("density");sd=g("sdk");lo=g("locale");av=g("app_version");en=g("enabled");if(en=="")en="true"}
 else  {p=$1;s=$2;m=$3;w=($4==""?"":$4+1);h=($5==""?"":$5+1);d="";sd="";lo="";av="";en="true"}}
END{if(!fd){print "NOTFOUND";exit}
 U=sprintf("%c",31)
 printf "%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n",sc,U,cl(p),U,cl(s),U,cl(m),U,cl(w),U,cl(h),U,cl(d),U,cl(sd),U,cl(lo),U,cl(av),U,cl(en)}
function g(n,  i,v){i=c[n];if(i==0||i>NF)return "";v=$i;gsub(/^[ \t]+|[ \t]+$/,"",v);return v}
function cl(v){gsub(/[\t\r\n\037]/," ",v);return v}
' "$REGISTRY")"
[[ "$_registry_row" != "NOTFOUND" && -n "$_registry_row" ]] || die "unknown phone profile: $PROFILE"
IFS=$'\037' read -r REGISTRY_SCHEMA registry_profile SERIAL MODEL SCREEN_W SCREEN_H \
  DEVICE_DENSITY DEVICE_SDK DEVICE_LOCALE DEVICE_APP_VERSION PROFILE_ENABLED <<< "$_registry_row"
[[ "$registry_profile" == "$PROFILE" && -n "$SERIAL" && -n "$MODEL" ]] || die "invalid phone profile registry row"
[[ "$PROFILE_ENABLED" != "false" ]] || die "phone profile is disabled in registry: $PROFILE"
require_uint "$SCREEN_W"
require_uint "$SCREEN_H"
# registry 统一存真实分辨率；坐标上限由此处派生，不再让人手工在表里减一。
MAX_X=$(( SCREEN_W - 1 ))
MAX_Y=$(( SCREEN_H - 1 ))
# density 决定 dp↔px 换算。v1 registry 没有这一列：留空并由调用方判断，
# 绝不填默认值——猜一个 density 会让坐标静默偏移，比直接报错危险得多。
if [[ -n "$DEVICE_DENSITY" ]]; then require_uint "$DEVICE_DENSITY"; fi

REMOTE_SHOT="/sdcard/douyin-leadgen-shot-${PROFILE}.png"
LOCAL_SHOT="/private/tmp/openclaw-phone/douyin-leadgen-shot-${PROFILE}.png"
REMOTE_UI="/sdcard/douyin-leadgen-ui-${PROFILE}.xml"
EVIDENCE_ROOT="/private/tmp/openclaw-phone/evidence/${PROFILE}"
EVIDENCE_BUNDLE_ROOT="/private/tmp/openclaw-phone/evidence-bundles/${PROFILE}"
DOUYIN_PACKAGE="com.ss.android.ugc.aweme"
LOCK_ROOT="/private/tmp/openclaw-phone/locks"
LOCK_DIR="$LOCK_ROOT/${SERIAL}.lock"

check_target_fast() {
  local state
  state="$($ADB -s "$SERIAL" get-state 2>/dev/null || print -- offline)"
  if [[ "$state" != "device" ]]; then
    "$ADB" start-server >/dev/null 2>&1 || true
    state="$($ADB -s "$SERIAL" get-state 2>/dev/null || print -- offline)"
  fi
  [[ "$state" == "device" ]] || die "target phone is offline after adb auto-refresh"
}

check_target() {
  local actual_model
  check_target_fast
  actual_model="$($ADB -s "$SERIAL" shell getprop ro.product.model | tr -d '\r')"
  [[ "$actual_model" == "$MODEL" ]] || die "target model mismatch"
}

# 波间长等待：wait_ms 硬顶 5 秒（防手滑写成分钟级，保留该限制），
# 这里单独提供一个受控的长等待，上限 120 秒。
wait_seconds() {
  local total i
  total="$1"
  require_uint "$total"
  (( total <= 120 )) || die "long wait must be <= 120 s"
  for (( i = 0; i < total; i++ )); do /bin/sleep 1; done
}

wait_ms() {
  local milliseconds seconds
  milliseconds="$1"
  require_uint "$milliseconds"
  (( milliseconds <= 5000 )) || die "wait must be <= 5000 ms"
  seconds="$(/usr/bin/printf '%d.%03d' $(( milliseconds / 1000 )) $(( milliseconds % 1000 )))"
  /bin/sleep "$seconds"
}

snapshot() {
  "$ADB" -s "$SERIAL" shell screencap -p "$REMOTE_SHOT"
  /bin/mkdir -p "${LOCAL_SHOT:h}"
  "$ADB" -s "$SERIAL" pull "$REMOTE_SHOT" "$LOCAL_SHOT" >/dev/null
  print -- "$LOCAL_SHOT"
}

require_evidence_id() {
  [[ "$1" == [A-Za-z0-9._-]## ]] || die "evidence id contains unsupported characters"
  (( ${#1} <= 160 )) || die "evidence id is too long"
}

snapshot_evidence() {
  local evidence_id local_path
  evidence_id="$1"
  require_evidence_id "$evidence_id"
  local_path="$EVIDENCE_ROOT/${evidence_id}.png"
  "$ADB" -s "$SERIAL" shell screencap -p "$REMOTE_SHOT"
  /bin/mkdir -p "$EVIDENCE_ROOT"
  "$ADB" -s "$SERIAL" pull "$REMOTE_SHOT" "$local_path" >/dev/null
  print -- "$local_path"
}

_ui_evidence_wave() {
  local evidence_id local_path dump_output remote_size dump_attempt dump_status
  evidence_id="$1"
  require_evidence_id "$evidence_id"
  local_path="$EVIDENCE_ROOT/${evidence_id}.xml"
  /bin/mkdir -p "$EVIDENCE_ROOT"

  # Douyin video pages keep animating even when the user is not interacting.
  # uiautomator can report that it did not reach idle while still producing a
  # fresh, complete hierarchy. Remove both copies before every attempt so an
  # earlier XML can never be accepted, then validate the newly generated XML
  # structurally instead of treating the idle warning itself as fatal.
  # 20260903: 旧注释声称的"Worker 30秒 node_exec 天花板"已查明是 OpenClaw gateway
  # node.invoke 顶层漏传 timeoutMs 的 bug（默认30s），已打补丁拆除；worker 显式 timeout
  # 现在真实生效(120-180s)。此处仍保持快速失败，交给 stage 级重试策略。
  for dump_attempt in 1 2 3; do
    /bin/rm -f "$local_path"
    "$ADB" -s "$SERIAL" shell rm -f "$REMOTE_UI" >/dev/null
    dump_status=0
    if dump_output="$("$ADB" -s "$SERIAL" shell uiautomator dump --compressed "$REMOTE_UI" 2>&1)"; then
      dump_status=0
    else
      dump_status=$?
    fi
    remote_size="$("$ADB" -s "$SERIAL" shell stat -c %s "$REMOTE_UI" 2>/dev/null | tr -d '\r' || print -- 0)"
    if [[ "$remote_size" == <-> ]] && (( remote_size > 0 )); then
      "$ADB" -s "$SERIAL" pull "$REMOTE_UI" "$local_path" >/dev/null
      if [[ -s "$local_path" ]] \
        && /usr/bin/grep -q '<hierarchy' "$local_path" \
        && /usr/bin/grep -q '</hierarchy>' "$local_path"; then
        if (( dump_status != 0 )) || [[ "$dump_output" == *"ERROR:"* ]]; then
          print -u2 -- "warning: accepted fresh complete hierarchy despite dynamic-page idle warning (attempt $dump_attempt)"
        fi
        print -- "$local_path"
        return 0
      fi
    fi
    # 波内也要留时间：背靠背瞬发三次，页面还在动的话必然三次同样失败。
    (( dump_attempt < 3 )) && wait_ms 900
  done
  # 详情页自动播放机型（HONOR 实测）：暂停→抓→恢复三连兜底，总耗时 ~13s。
  if [[ "$dump_output" == *"could not get idle state"* ]]; then
    # 改用媒体键：详情页可暂停视频，其它页面无副作用——绝不制造导航（a7 案卷：点击版把搜索页点飞）。
    "$ADB" -s "$SERIAL" shell input keyevent 85
    wait_ms 500
    "$ADB" -s "$SERIAL" shell rm -f "$REMOTE_UI" >/dev/null
    dump_output="$("$ADB" -s "$SERIAL" shell uiautomator dump --compressed "$REMOTE_UI" 2>&1)" || true
    remote_size="$("$ADB" -s "$SERIAL" shell stat -c %s "$REMOTE_UI" 2>/dev/null | tr -d $'\r' || print -- 0)"
    "$ADB" -s "$SERIAL" shell input keyevent 85
    if [[ "$remote_size" == <-> ]] && (( remote_size > 0 )); then
      "$ADB" -s "$SERIAL" pull "$REMOTE_UI" "$local_path" >/dev/null
      if [[ -s "$local_path" ]] && /usr/bin/grep -q "<hierarchy" "$local_path" && /usr/bin/grep -q "</hierarchy>" "$local_path"; then
        print -u2 -- "warning: hierarchy captured via pause-dump-resume fallback (single-shot)"
        print -- "$local_path"
        return 0
      fi
    fi
  fi
  return 1
}

# 已知存在的东西，不该一次读不到就放弃（0912 主理人定的原则）：
# 分三波，波内 3 次（间隔 0.9s）+ 暂停抓取兜底，波间分别等 20s / 40s，
# 给页面加载、动画、网络真正留出时间。最坏约 80 秒，仍在 worker 120-180s 预算内。
ui_evidence() {
  local evidence_id wave out
  evidence_id="$1"
  require_evidence_id "$evidence_id"
  # 已知存在的东西不该一次读不到就放弃：三波，波内 3 次 + 暂停抓取兜底，
  # 波间 10s / 20s。成功路径不受影响（实测 2.8 秒返回，其中 2.7 秒是设备端
  # uiautomator dump 本身的地板耗时，封装只占 0.15 秒）。
  # 最坏约 180 秒——skill 侧的 exec timeout 下限已同步抬到 300000ms。
  for wave in 1 2 3; do
    if out="$(_ui_evidence_wave "$evidence_id")"; then
      (( wave > 1 )) && print -u2 -- "warning: ui hierarchy obtained on wave $wave/3"
      print -- "$out"
      return 0
    fi
    if (( wave < 3 )); then
      print -u2 -- "warning: ui hierarchy unavailable (wave $wave/3); waiting before the next wave"
      (( wave == 1 )) && wait_seconds 10
      (( wave == 2 )) && wait_seconds 20
    fi
  done
  die "uiautomator dump did not produce a fresh complete hierarchy after 3 waves (~180s); use current screenshot evidence instead"
}

# 0914 融合刀1: 已删除死函数 ui_evidence_retry(零调用者)。其中的 pause-dump-resume
# 兜底段在某次补丁中被变量提前展开毁成死代码(空串 -s 空串 形态,字面模式勿写出——smoke 烂死守卫会命中)。健康的媒体键版兜底
# 一直活在 _ui_evidence_wave 里,统一走 ui_evidence 三波协议。

# 0914 融合刀2(抄 Kotlin clearClipboardBaseline 教义): ADB 无法进程内清剪贴板,
# 等价防线 = 每 profile 记录上次成功取到的短链;本次读数与上次相同 → 本次"复制"动作
# 大概率静默失败,剪贴板里是上一个目标的旧链接。张冠李戴比取不到更毒,当场拒收。
# 同目标重试天然安全:上次记录的是上一个目标的链接,同目标重拷出的链接与它不同。
clip_state_file() { print -- "$LOCATE_CACHE_DIR/${registry_profile}-last-clip.txt" }
clip_guard_check() {
  local _prev _f
  _f="$(clip_state_file)"
  [[ -r "$_f" ]] || return 0
  _prev="$(<"$_f")"
  [[ -n "$_prev" && "$_prev" == "$1" ]] && die "COPY_STALE: clipboard still holds the previous target's link ($1); the copy tap likely failed silently — refusing to attribute it to this target" TARGET_ABSENT
  return 0
}
clip_guard_record() {
  /bin/mkdir -p "$LOCATE_CACHE_DIR" 2>/dev/null || true
  print -- "$1" > "$(clip_state_file)"
}

node_center() {
  local node_line bounds x1 y1 x2 y2
  node_line="$1"
  bounds="$(print -- "$node_line" | /usr/bin/sed -E 's/.*bounds="\[([0-9]+),([0-9]+)\]\[([0-9]+),([0-9]+)\]".*/\1 \2 \3 \4/')"
  read x1 y1 x2 y2 <<< "$bounds"
  require_uint "$x1"; require_uint "$y1"; require_uint "$x2"; require_uint "$y2"
  (( x2 > x1 && y2 > y1 && x1 <= MAX_X && y1 <= MAX_Y && x2 <= MAX_X + 1 && y2 <= MAX_Y + 1 )) || die "semantic node bounds are outside target screen"
  print -- "$(( (x1 + x2) / 2 )) $(( (y1 + y2) / 2 ))"
}

# 视频详情页的确定性判据：分享按钮存在。搜索结果页 / 用户主页都没有它。
# 0912 实证：worker 在搜索结果页直接调 current-video-link，找不到分享按钮后盲按两次返回，
# 把设备一路退到用户主页、最后退出抖音，后续 4 次重试全部注定失败且越退越偏。
# 所以"根本不在详情页"必须当硬错误立即报出，不许进重试、不许按返回键。
# 返回码三态，绝不把"读不到树"和"读到了但不是详情页"混为一谈（那会把瞬态问题
# 误报成结构性问题，害人往错方向修）：0=在详情页 1=不在详情页 2=树读不到(瞬态,可重试)
_on_video_detail() {
  local probe_id="$1" probe_xml probe_line w
  for w in 1 2; do
    probe_xml="$EVIDENCE_ROOT/${probe_id}-w${w}.xml"
    if _ui_evidence_wave "${probe_id}-w${w}" >/dev/null 2>&1; then
      probe_line="$(/usr/bin/grep -oE '<node[^>]+content-desc="分享[^"]*，按钮"[^>]*>' "$probe_xml" | /usr/bin/head -1 || true)"
      [[ -n "$probe_line" && "$probe_line" == *'clickable="true"'* ]] && return 0
      return 1
    fi
    (( w == 1 )) && wait_ms 2500
  done
  return 2
}

# 取链接偶发失败(面板没弹/剪贴板没同步/超时)不该一击致死：整体包重试，连试到成功。
# 每次在干净的详情页重来(die在subshell里只退出子壳,外层捕获重试)。
current_video_link() {
  local eid="$1" tries=5 i rc _g
  require_evidence_id "$eid"
  _g=0; _on_video_detail "${eid}-detail-guard" || _g=$?   # 必须用 || 捕获：set -e 下裸调用返回非零会静默终止脚本，错误信息一个字都不打
  (( _g == 2 )) && die "UI_TREE_UNAVAILABLE: could not read the UI hierarchy to verify the video detail page; transient, safe to retry" NO_ROOT
  (( _g == 1 )) && die "NOT_ON_VIDEO_DETAIL: current-video-link requires an opened video detail page (share button absent); open the video card first"
  for i in {1..$tries}; do
    if ( _current_video_link_once "${eid}-t${i}" ); then return 0; fi
    rc=$?
    print -u2 -- "warning: current-video-link attempt $i/$tries failed (rc=$rc); recovering to detail page"
    # 回退到详情页干净态：连按返回收掉可能半开的分享面板/临时搜索框
    "$ADB" -s "$SERIAL" shell input keyevent 4 >/dev/null 2>&1
    wait_ms 600
    "$ADB" -s "$SERIAL" shell input keyevent 4 >/dev/null 2>&1
    wait_ms 800
    [[ "$(foreground_package)" == *"$DOUYIN_PACKAGE"* ]] || die "Douyin left foreground during link retry recovery" WRONG_FOREGROUND
    _g=0; _on_video_detail "${eid}-t${i}-recovery-guard" || _g=$?
    (( _g == 2 )) && die "UI_TREE_UNAVAILABLE after recovery attempt $i; transient, safe to retry" NO_ROOT
    (( _g == 1 )) && die "recovery after attempt $i did not land on a video detail page; aborting instead of drifting the device further"
  done
  die "current-video-link failed after $tries attempts"
}

_current_video_link_once() {
  local evidence_id share_xml share_line share_center share_x share_y panel_xml panel_line link_line link_bounds
  local link_x1 link_y1 link_x2 link_y2 link_x link_y
  local copied_path scratch_xml search_line search_center search_x search_y
  local result_xml result_line escaped_text short_url resolved_url video_id note_id content_type content_id reopen_url
  evidence_id="$1"
  require_evidence_id "$evidence_id"

  [[ "$(foreground_package)" == *"$DOUYIN_PACKAGE"* ]] || die "Douyin is not foreground"
  # 详情页自动播放会让部分机型（HONOR 实测）uiautomator 永不 idle：
  # 先中央点击暂停播放再取证；流程末尾跳离本页，无需恢复播放。
  "$ADB" -s "$SERIAL" shell input tap $(( SCREEN_W / 2 )) $(( SCREEN_H * 45 / 100 ))
  wait_ms 600
  # 分享按钮是详情页上"已知存在"的东西，一次读不到不该放弃（0913 实证：前置守卫刚放行、
  # 正式取证却报找不到，两者之间只隔了上面那次中央点击）。有界重抓，并区分两种死因：
  #   a) 中央点击把页面点飞了 → 已不在详情页
  #   b) 还在详情页但按钮没渲染出来 → 纯时序问题，重抓即可
  share_xml="$EVIDENCE_ROOT/${evidence_id}-share.xml"
  share_line=""
  local _st _sg
  for _st in 1 2 3; do
    ui_evidence "${evidence_id}-share" >/dev/null
    share_line="$(/usr/bin/grep -oE '<node[^>]+content-desc="分享[^"]*，按钮"[^>]*>' "$share_xml" | /usr/bin/head -1 || true)"
    [[ -n "$share_line" && "$share_line" == *'clickable="true"'* ]] && break
    share_line=""
    print -u2 -- "warning: share button absent from hierarchy (try $_st/3); recapturing"
    (( _st < 3 )) && wait_ms 1500
  done
  if [[ -z "$share_line" ]]; then
    _sg=0; _on_video_detail "${evidence_id}-share-diag" || _sg=$?
    (( _sg == 1 )) && die "the centre tap navigated away from the video detail page (share button gone); this is not a missing-button problem"
    die "verified share button was not found after 3 captures while still on the video detail page" TARGET_ABSENT
  fi
  share_center="$(node_center "$share_line")" || die "share button bounds could not be parsed"
  read share_x share_y <<< "$share_center"
  "$ADB" -s "$SERIAL" shell input tap "$share_x" "$share_y"
  wait_ms 700

  panel_xml="$EVIDENCE_ROOT/${evidence_id}-panel.xml"
  ui_evidence "${evidence_id}-panel" >/dev/null
  panel_line="$(/usr/bin/grep -oE '<node[^>]+text="分享给"[^>]*>' "$panel_xml" | /usr/bin/head -1 || true)"
  [[ -n "$panel_line" ]] || die "verified share panel was not found"

  link_line="$(/usr/bin/grep -oE '<node[^>]+text="分享链接"[^>]*>' "$panel_xml" | /usr/bin/head -1 || true)"
  [[ -n "$link_line" ]] || die "share-link action was not present in the verified panel"
  link_bounds="$(print -- "$link_line" | /usr/bin/sed -E 's/.*bounds="\[([0-9]+),([0-9]+)\]\[([0-9]+),([0-9]+)\]".*/\1 \2 \3 \4/')"
  read link_x1 link_y1 link_x2 link_y2 <<< "$link_bounds"
  require_uint "$link_x1"; require_uint "$link_y1"; require_uint "$link_x2"; require_uint "$link_y2"
  (( link_x2 > link_x1 && link_y2 > link_y1 && link_x1 <= MAX_X && link_y1 > 200 && link_y2 <= MAX_Y + 1 )) || die "share-link action bounds are outside target screen"
  link_x=$(( (link_x1 + link_x2) / 2 ))
  link_y=$(( link_y1 - 96 ))
  (( link_y > 0 && link_y <= MAX_Y )) || die "share-link action tap point is outside target screen"
  "$ADB" -s "$SERIAL" shell input tap "$link_x" "$link_y"
  wait_ms 800
  copied_path="$(snapshot_evidence "${evidence_id}-link-copied")"

  "$ADB" -s "$SERIAL" shell am start -a android.intent.action.VIEW -d "snssdk1128://search/tabs?keyword=%20" >/dev/null
  wait_ms 900
  scratch_xml="$EVIDENCE_ROOT/${evidence_id}-scratch.xml"
  ui_evidence "${evidence_id}-scratch" >/dev/null
  search_line="$(/usr/bin/grep -oE '<node[^>]+resource-id="com.ss.android.ugc.aweme:id/et_search_kw"[^>]*>' "$scratch_xml" | /usr/bin/head -1 || true)"
  [[ -n "$search_line" && "$search_line" == *'clickable="true"'* ]] || die "safe scratch search field was not found"
  search_center="$(node_center "$search_line")" || die "scratch field bounds could not be parsed"
  read search_x search_y <<< "$search_center"
  "$ADB" -s "$SERIAL" shell input tap "$search_x" "$search_y"
  wait_ms 200
  "$ADB" -s "$SERIAL" shell input keyevent 123
  "$ADB" -s "$SERIAL" shell input keyevent 67
  "$ADB" -s "$SERIAL" shell input keyevent 67
  "$ADB" -s "$SERIAL" shell input keyevent 279
  wait_ms 500
  result_xml="$EVIDENCE_ROOT/${evidence_id}-scratch-result.xml"
  ui_evidence "${evidence_id}-scratch-result" >/dev/null
  result_line="$(/usr/bin/grep -oE '<node[^>]+resource-id="com.ss.android.ugc.aweme:id/et_search_kw"[^>]*>' "$result_xml" | /usr/bin/head -1 || true)"
  [[ -n "$result_line" ]] || die "clipboard verification field was not found"
  escaped_text="$(print -- "$result_line" | /usr/bin/sed -E 's/.* text="([^"]*)" resource-id=.*/\1/' | /usr/bin/sed 's/&amp;/\&/g; s/&#47;/\//g')"
  short_url="$(print -- "$escaped_text" | /usr/bin/grep -oE 'https://v\.douyin\.com/[A-Za-z0-9_/-]+' | /usr/bin/head -1 || true)"
  [[ "$short_url" == https://v.douyin.com/* ]] || die "copied text did not contain a verified Douyin short link" TARGET_ABSENT
  clip_guard_check "$short_url"
  resolved_url="$(/usr/bin/curl -sSIL --max-time 20 -A 'Mozilla/5.0' "$short_url" | /usr/bin/awk -F ': ' 'tolower($1) == "location" { gsub(/\r/, "", $2); location=$2 } END { print location }' || true)"
  video_id="$(print -- "$resolved_url" | /usr/bin/grep -oE '/video/[0-9]+' | /usr/bin/tail -1 | /usr/bin/cut -d/ -f3 || true)"
  note_id="$(print -- "$resolved_url" | /usr/bin/grep -oE '/note/[0-9]+' | /usr/bin/tail -1 | /usr/bin/cut -d/ -f3 || true)"
  if [[ "$video_id" == <-> && ${#video_id} -ge 16 && ${#video_id} -le 24 ]]; then
    content_type="video"
    content_id="$video_id"
  elif [[ "$note_id" == <-> && ${#note_id} -ge 16 && ${#note_id} -le 24 ]]; then
    content_type="note"
    content_id="$note_id"
  else
    die "resolved link did not contain a valid video or note id"
  fi
  reopen_url="snssdk1128://aweme/detail/$content_id"

  if [[ "$content_type" == "video" ]]; then
    "$ADB" -s "$SERIAL" shell am start -a android.intent.action.VIEW -d "$reopen_url" >/dev/null
    wait_ms 900
  else
    # The scratch search field still has keyboard focus. First back hides the
    # keyboard; the second leaves the scratch route so the Worker can reopen
    # the frozen keyword and continue after excluding the note.
    "$ADB" -s "$SERIAL" shell input keyevent 4
    wait_ms 250
    "$ADB" -s "$SERIAL" shell input keyevent 4
    wait_ms 900
  fi
  [[ "$(foreground_package)" == *"$DOUYIN_PACKAGE"* ]] || die "resolved content did not restore to Douyin" WRONG_FOREGROUND
  clip_guard_record "$short_url"
  print -- "content_type=$content_type"
  if [[ "$content_type" == "video" ]]; then
    print -- "content_id=$content_id"
    print -- "video_id=$video_id"
    print -- "short_url=$short_url"
    print -- "resolved_url=$resolved_url"
    print -- "reopen_url=$reopen_url"
  else
    print -- "excluded_non_video=true"
    print -- "note_id=$note_id"
    print -- "short_url=$short_url"
    print -- "resolved_url=$resolved_url"
  fi
  print -- "evidence=$copied_path"
}

filter_option_grid_index() {
  case "$1:$2" in
    sort:comprehensive) print -- "0 0" ;;
    sort:latest) print -- "0 1" ;;
    sort:most_liked) print -- "0 2" ;;
    sort:most_commented) print -- "0 3" ;;
    sort:most_favorited) print -- "1 0" ;;
    time:unlimited) print -- "2 0" ;;
    time:one_day) print -- "2 1" ;;
    time:one_week) print -- "2 2" ;;
    time:six_months) print -- "2 3" ;;
    duration:unlimited) print -- "3 0" ;;
    duration:under_one_minute) print -- "3 1" ;;
    duration:one_to_five_minutes) print -- "3 2" ;;
    duration:over_five_minutes) print -- "3 3" ;;
    scope:unlimited) print -- "4 0" ;;
    scope:watched) print -- "4 1" ;;
    scope:not_watched) print -- "4 2" ;;
