    # 前置：必须已在视频 tab（综合 tab 内嵌自动播放，dump 永远 could not get idle state）。
    # 输出 TSV：x y 标题
    [[ "$#" == 2 ]] || die "usage: douyin-phone-adb --profile PROFILE search-video-cards EVIDENCE_ID"
    check_target
    # 已知存在的东西不该一次读不到就放弃（0912 主理人定的原则）。
    # ui_evidence 自身已分三波重试；这里再补一层业务级重试：只要页面没有明确
    # 说「搜索结果为空」，就隔 15 秒重抓，共 3 轮。页面确实说空了，则明确输出
