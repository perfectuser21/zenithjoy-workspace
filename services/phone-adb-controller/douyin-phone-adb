locate_filter_option() {
  local screenshot_path grid_index row_index column_index
  screenshot_path="$1"
  grid_index="$(filter_option_grid_index "$2" "$3")" || die "unsupported search filter option: $2=$3"
  read row_index column_index <<< "$grid_index"
  "$PYTHON_BIN" - "$screenshot_path" "$row_index" "$column_index" <<'PY'
import sys
from PIL import Image

path, row_arg, column_arg = sys.argv[1:]
row_index, column_index = int(row_arg), int(column_arg)
image = Image.open(path).convert("RGB")
w, h = image.size
if w < 480 or h < 800:
    raise SystemExit("filter option locator failed: screenshot dimensions are unexpected")

def is_chip(pixel):
    r, g, b = pixel
    return r >= 235 and g >= 232 and b >= 232 and (min(r, g, b) < 253 or r - g > 4 or r - b > 4)

def groups(flags, max_gap, min_size):
    found, start, last = [], None, None
    for index, enabled in enumerate(flags):
        if enabled:
            if start is None:
                start = index
            last = index
        elif start is not None and index - last > max_gap:
            if last - start + 1 >= min_size:
                found.append((start, last))
            start = last = None
    if start is not None and last - start + 1 >= min_size:
        found.append((start, last))
    return found

x0, x1 = int(w * 0.02), int(w * 0.98)
y0, y1 = int(h * 0.16), int(h * 0.69)
row_flags = []
for y in range(y0, y1):
    chip_pixels = sum(is_chip(image.getpixel((x, y))) for x in range(x0, x1, 3))
    row_flags.append(chip_pixels >= (x1 - x0) * 0.07 / 3)
row_bands = [(a + y0, b + y0) for a, b in groups(row_flags, max_gap=10, min_size=max(24, int(h * 0.018)))]
if len(row_bands) < 5:
    raise SystemExit(f"filter option locator failed: expected at least five visual chip rows, found {len(row_bands)}")

def _drop_button_row(bands):
    """尾部若是「重置选项/查看结果」按钮行（含大片红色），从筛选行里剔除。"""
    out = list(bands)
    while out:
        top, bottom = out[-1]
        patch = image.crop((int(w * 0.02), top, int(w * 0.98), bottom + 1))
        px = list(patch.getdata())
        red = sum(1 for r, g, b in px if r > 220 and g < 125 and b < 165) / len(px)
        if red >= 0.10:
            out.pop()
            continue
        break
    return out


def _resolve_row(bands, logical_row):
    """逻辑行 → 实际检测行：从底部锚定，抗抖音增删排序选项导致的整体位移。
    逻辑约定 0/1=排序 2=时间 3=时长 4=范围 5=位置；位置永远是最后一个筛选行。"""
    rows = _drop_button_row(bands)
    n = len(rows)
    # 0914 实证(小诺机):部分账号/版本无「位置距离」组=4行布局,授权定位也不出现
    has_location = n >= 5
    if n < 4:
        raise SystemExit(f"filter grid failed: expected at least four filter rows, found {n}")
    if logical_row == 5 and not has_location:
        raise SystemExit("NO_LOCATION_ROW: 4-row filter panel without 位置距离")
    tail = ({5: n - 1, 4: n - 2, 3: n - 3, 2: n - 4} if has_location else {4: n - 1, 3: n - 2, 2: n - 3})
    if logical_row in tail:
        return rows[tail[logical_row]]
    sort_rows = rows[: n - (4 if has_location else 3)]
    if logical_row >= len(sort_rows):
        raise SystemExit(f"filter grid failed: sort row {logical_row} missing (only {len(sort_rows)} sort rows)")
    return rows[logical_row]


top, bottom = _resolve_row(row_bands, row_index)
column_flags = []
row_height = bottom - top + 1
for x in range(x0, x1):
    chip_pixels = sum(is_chip(image.getpixel((x, y))) for y in range(top, bottom + 1, 2))
    column_flags.append(chip_pixels >= row_height * 0.32 / 2)
column_bands = [(a + x0, b + x0) for a, b in groups(column_flags, max_gap=12, min_size=max(45, int(w * 0.10)))]
if column_index >= len(column_bands):
    raise SystemExit(f"filter option locator failed: row {row_index} has {len(column_bands)} visual chips")
left, right = column_bands[column_index]
print(f"{(left + right) // 2} {(top + bottom) // 2}")
PY
}

