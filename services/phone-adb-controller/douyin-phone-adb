locate_filter_action_button() {
  "$PYTHON_BIN" - "$1" <<'PY'
import statistics
import sys
from PIL import Image

image = Image.open(sys.argv[1]).convert("RGB")
w, h = image.size
# 「查看结果」按钮的纵向位置随面板高度变化（抖音增删排序选项即整体位移）。
# 不写死区间：在下半屏扫描红色像素，按行聚成带，取点数最多的一带的中位点。
