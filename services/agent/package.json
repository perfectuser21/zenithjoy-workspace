{
  "name": "@zenithjoy/agent",
  "version": "2.0.66",
  "description": "ZenithJoy Agent — 后台进程，把 Windows 主机变成 ZenithJoy 中台的发布端",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --external:systray2",
    "package:win": "npm run build && node scripts/prepare-base-icon.js build/icon.ico && pkg . --targets node18-win-x64 --output zenithjoy-agent.exe",
    "package:mac": "npm run build && pkg . --targets node18-macos-x64 --output zenithjoy-agent-mac",
    "package:linux": "npm run build && pkg . --targets node18-linux-x64 --output zenithjoy-agent-linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "node-notifier": "^10.0.1",
    "playwright": "^1.49.0",
    "systray2": "^2.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.21.0",
    "pkg": "^5.8.1",
    "rcedit": "^3.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "scripts": [],
    "assets": [
      "build/tray-icon.png",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/systray2/traybin/**/*",
      "node_modules/playwright-core/browsers.json",
      "node_modules/playwright-core/**/*.json",
      "node_modules/playwright-core/index.js",
      "node_modules/playwright-core/lib/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist-pkg"
  }
}