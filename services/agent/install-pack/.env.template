# ZenithJoy Agent 配置
# 注意：这里的 ZENITHJOY_API_BASE 只是「未应用个人 .env」时的生产兜底默认值。
# 从 dashboard「下载个人配置 .env」拿到的个人 .env 会按你下载的环境（staging-autopilot / autopilot）
# 烧好 ZENITHJOY_API_BASE/URL + ZENITHJOY_ENV 并整文件盖掉本模板 —— 那才是连接地址的权威来源。
ZENITHJOY_API_BASE=https://autopilot.zenjoymedia.media
ZENITHJOY_LICENSE=ZJ-F-XXXXXX
ZENITHJOY_CHROME_DEBUG_PORT=19222
ZENITHJOY_AGENT_DRYRUN_BROWSER=mock
ZENITHJOY_AGENT_REAL_PUBLISH=1
