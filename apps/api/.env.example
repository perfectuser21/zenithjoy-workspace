# Server Configuration
PORT=5200
NODE_ENV=development

# PostgreSQL Configuration (for Works Management API)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cecelia
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Platform Data API (existing, port 5220)
# This is for the platform-data endpoint

# ToAPI Configuration (Video Generation Service)
# IMPORTANT: This key should NEVER be in frontend code (no VITE_ prefix)
# Store actual key in ~/.credentials/toapi.env or use CI/CD secrets
TOAPI_API_KEY=your_toapi_key_here

# Path 2 Sprint A — 飞书多租户集成
# 生产固定 https://open.feishu.cn；CI 改为 http://localhost:3099 指向 fake-feishu-server
FEISHU_API_BASE=https://open.feishu.cn
# state HMAC 签名密钥（生产必改，否则 callback 验签固定）
FEISHU_STATE_SECRET=path2-feishu-state-default-please-override-in-prod
# OAuth callback 跳回 dashboard 的 base URL（302 跳转）
DASHBOARD_BASE_URL=http://localhost:5173
# 飞书 OAuth 回调 URL（生产用公网 URL，dev 用 localhost）
# 不设时 fallback 到 ${DASHBOARD_BASE_URL}/api/feishu/oauth/callback；再 fallback http://localhost:5200/api/feishu/oauth/callback
FEISHU_REDIRECT_URI=http://localhost:5200/api/feishu/oauth/callback
# WS5 _smoke-feishu-seed helper 端点 token（生产 NODE_ENV=production 一律 404）
SMOKE_TOKEN=smoke-secret-2026
