# Environment variables
.env
.env.*
!.env.example
!.env.template
*.env

# Credentials
credentials/
*.key
*.pem
*.p12
*-credentials.json
*-secret.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node.js
node_modules/
# 不带斜杠的这条是必须的：`node_modules/` 只匹配目录，匹配不到**软链**。
# git worktree 里常把 node_modules 软链到主 checkout，之前就因为这个被
# `git add -A` 连软链一起提交进来，CI 上 npm 要建同名目录直接 ENOTDIR 全红。
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
# Portable Node.js zip — downloaded at build time, not committed
services/agent/install-pack/node-v*-win-x64.zip

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Build outputs
dist/
build/
# Agent 打包资源（logo / icon）需要纳入版本控制
!services/agent/build/
!services/agent/build/**
*.egg-info/
.cache/
.next/

# Logs
logs/
*.log
log/

# Database
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
# 例外：迁移脚本必须入库
!services/creator/migrations/*.sql
!apps/api/db/migrations/*.sql
!apps/api/db/seeds/*.sql
!db/migrations/*.sql
!packages/db/migrations/*.sql
# 例外：sprint E2E 种子 SQL 是 CI 工件，必须入库
!sprints/**/*.sql

